@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <div class="header-left">
            <a class="app-logo" href="">
                <i class="bi bi-image-fill"></i>
                <span>ImageGenerator</span>
            </a>
        </div>
    </header>

    <main class="app-main">
        @Body
