@page "/"

<PageTitle>ImageGenerator</PageTitle>

<div class="ig">

    <!-- Header / Action bar -->
    <div class="ig-actions">
        <div class="ig-actions-left">
            <!-- 生成件数 -->
            <div class="ig-param-group">
                <label class="ig-label">生成件数</label>
                <select class="ig-select" @bind="generateCount" disabled="@IsBusy">
                    @for (var i = 1; i <= 8; i++)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
            </div>

            <!-- サイズ -->
            <div class="ig-param-group">
                <label class="ig-label">サイズ</label>
                <select class="ig-select" value="@generateParameters.Size"
                        @onchange="e => generateParameters = generateParameters with { Size = e.Value!.ToString()! }"
                        disabled="@IsBusy">
                    <option value="1024x1024">1024×1024（正方形）</option>
                    <option value="1024x1536">1024×1536（縦長）</option>
                    <option value="1536x1024">1536×1024（横長）</option>
                </select>
            </div>

            <!-- 品質 -->
            <div class="ig-param-group">
                <label class="ig-label">品質</label>
                <select class="ig-select" value="@generateParameters.Quality"
                        @onchange="e => generateParameters = generateParameters with { Quality = e.Value!.ToString()! }"
                        disabled="@IsBusy">
                    <option value="low">Low（低・高速）</option>
                    <option value="medium">Medium（中）</option>
                    <option value="high">High（高・低速）</option>
                </select>
            </div>

            <!-- 出力形式 -->
            <div class="ig-param-group">
                <label class="ig-label">形式</label>
                <select class="ig-select" value="@generateParameters.OutputFormat"
                        @onchange="e => generateParameters = generateParameters with { OutputFormat = e.Value!.ToString()! }"
                        disabled="@IsBusy">
                    <option value="png">PNG</option>
                    <option value="jpeg">JPEG</option>
                </select>
            </div>

            <!-- 圧縮率（JPEG 時のみ有効） -->
            <div class="ig-param-group ig-param-compression @(generateParameters.OutputFormat != "jpeg" ? "ig-param-disabled" : "")">
                <label class="ig-label">
                    圧縮率
                    <span class="ig-param-value">@generateParameters.OutputCompression</span>
                </label>
                <input type="range" class="ig-slider" min="0" max="100" step="5"
                       value="@generateParameters.OutputCompression"
                       @onchange="e => generateParameters = generateParameters with { OutputCompression = int.Parse(e.Value!.ToString()!) }"
                       disabled="@(IsBusy || generateParameters.OutputFormat != "jpeg")" />
            </div>
        </div>
        <div class="ig-actions-right">
            <button type="button" class="btn-se-primary" @onclick="GenerateAsync" disabled="@(IsBusy || string.IsNullOrWhiteSpace(prompt))">
                <i class="bi bi-magic"></i> 生成
            </button>
            <button type="button" class="btn-se-ghost" @onclick="ClearInputs" disabled="@IsBusy">
                <i class="bi bi-eraser"></i> クリア
            </button>
        </div>
    </div>

    <!-- Prompt area -->
    <div class="ig-prompt-area">
        <textarea class="ig-prompt" placeholder="プロンプトを入力してください。参照画像がある場合は Image01, Image02 などで参照できます。"
                  @bind="prompt" @bind:event="oninput" disabled="@IsBusy" rows="4"></textarea>

        <!-- Drop zone: transparent InputFile covers the entire area for both click and drag-and-drop -->
        <div class="ig-drop-zone @(isDragOver ? "drop-zone-active" : "") @(IsBusy ? "drop-zone-disabled" : "")"
             @ref="dropZoneRef"
             @ondragenter="OnDragEnter" @ondragleave="OnDragLeave"
             @ondragover:preventDefault
             @ondrop:preventDefault @ondrop="OnDrop">
            <i class="bi bi-cloud-arrow-up"></i>
            <span>参照画像をここにドラッグ＆ドロップ、またはクリックして選択（PNG / JPEG / WebP）</span>
            @if (!IsBusy)
            {
                <InputFile OnChange="OnFilesChangedAsync" multiple accept="image/png,image/jpeg,image/webp"
                           class="ig-drop-input" />
            }
        </div>

        <!-- Reference image thumbnails -->
        @if (uploadedImages.Count > 0)
        {
            <div class="ig-ref-images">
                @foreach (var img in uploadedImages)
                {
                    <div class="ig-ref-thumb" title="@img.Name">
                        <img src="@img.WebUrl" alt="@img.Name" />
                        <span class="ig-ref-label">@img.Name</span>
                        <button type="button" class="ig-ref-remove" @onclick="() => RemoveUploadedImage(img)" disabled="@IsBusy" title="削除">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Upload progress -->
    @if (isUploading)
    {
        <div class="ig-progress">
            <div class="spinner-se" role="status"></div>
            <span class="ig-progress-message">アップロード中...</span>
        </div>
    }

    <!-- Generation progress -->
    @if (isBusy)
    {
        <div class="ig-progress">
            <div class="spinner-se spinner-se-lg" role="status"></div>
            <div class="ig-progress-info">
                <span class="ig-progress-message">@progressMessage</span>
                <span class="ig-progress-elapsed">@progressElapsed</span>
            </div>
        </div>
    }

    <!-- Error -->
    @if (errorMessage is not null)
    {
        <div class="fb-error-toast">
            <i class="bi bi-exclamation-circle"></i>
            <span>@errorMessage</span>
            <button type="button" class="btn-se-icon" @onclick="() => errorMessage = null"><i class="bi bi-x"></i></button>
        </div>
    }

    <!-- Results -->
    @if (generatedImages.Count > 0)
    {
        <div class="ig-results-header">
            <span>生成結果 (@generatedImages.Count 件)</span>
        </div>
        <div class="ig-results">
            @foreach (var image in generatedImages)
            {
                <div class="ig-thumb" @onclick="() => OpenPreview(image)" title="@image.FileName">
                    <img src="@image.WebUrl" alt="@image.FileName" />
                    <div class="ig-thumb-info">
                        <span class="ig-thumb-name">@image.FileName</span>
                        <span class="ig-thumb-elapsed">@image.Elapsed.ToString(@"m\:ss")</span>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Preview dialog -->
    @if (previewImage is not null)
    {
        <div class="ig-preview-backdrop" @onclick="ClosePreview"></div>
        <div class="ig-preview-panel" @onclick:stopPropagation>
            <div class="ig-preview-header">
                <span class="ig-preview-filename">@previewImage.FileName</span>
                <span class="ig-preview-elapsed">処理時間: @previewImage.Elapsed.ToString(@"m\:ss\.ff")</span>
                <button type="button" class="btn-se-icon" @onclick="ClosePreview" title="閉じる">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="ig-preview-body">
                <img src="@previewImage.WebUrl" alt="@previewImage.FileName" class="ig-preview-image" />
            </div>
        </div>
    }

</div>
